# Production Nginx for browsemyvacations.com
# Copy to: /etc/nginx/conf.d/browsemyvacations.conf
# Then: nginx -t && systemctl reload nginx
#
# App ports (PM2):
#   bmv-web → 127.0.0.1:3100
#   bmv-api → 127.0.0.1:3101
#
# SSL certs are created by:
#   certbot --nginx -d browsemyvacations.com -d www.browsemyvacations.com

server {
    server_name browsemyvacations.com www.browsemyvacations.com;

    # Admin package image uploads (default nginx limit is 1m → HTTP 413)
    client_max_body_size 10m;

    location /api/ {
        proxy_pass http://127.0.0.1:3101/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /uploads/ {
        proxy_pass http://127.0.0.1:3101/uploads/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/browsemyvacations.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/browsemyvacations.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    if ($host = www.browsemyvacations.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    if ($host = browsemyvacations.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    server_name browsemyvacations.com www.browsemyvacations.com;
    return 404; # managed by Certbot
}
